    (ρ : ↥(GK K) → Matrix (Fin d) (Fin d) ℤ_[l]), (∀ g, IsUnit (ρ g)) → ∀ (s : WSeed bk d ρ τ),
    ∀ Φ : bk.DA bk.ρ₀ →+* bk.DA bk.ρ₀, IsDiscMap (l := _) (u := _) (ρ := _) WittVector.frobenius Φ →
      ((l : bk.DA bk.ρ₀) ^ (s.c₁ + s.c₂) * bk.iS (frobS l bk.a bk.E) ^ s.N) • s.W.map Φ =
        s.W * (s.X' * s.F.map (C : Wq l bk.a →+* bk.S) * s.X.map (frobS l bk.a)).map bk.iS :=
  fun l _ K bk τ hτ d _ _ s Φ hΦ =>
    GlobalTheory.BSP.discPeriods_frobenius_eq_mul l K bk τ hτ d s.W s.X s.X' s.F s.c₁ s.c₂ s.N s.X_mul Φ hΦ (s.φ Φ hΦ)

